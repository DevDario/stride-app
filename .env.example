# API base URL used by the axios client (public, bundled in JS)
EXPO_PUBLIC_API_URL=https://api.strideapp.com

# Clerk publishable key (public, bundled in JS)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxx

# Supabase data plane (public, bundled in JS). Identity is owned by Clerk,
# so these are the project URL and anon key, not a service role key.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# EAS-only env vars (not bundled, injected at build-time)
API_URL=https://api.strideapp.com
GOOGLE_MAPS_API_KEY=
STORAGE_KEY=
